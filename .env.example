# ---------- Entorno ----------
# Entorno: local | production
APP_ENV=local

# URL publica de la aplicacion (http://host/subcarpeta)
# De aqui se derivan SUBDIRECTORY y FILEMANAGERURL si no se definen aparte.
APP_URL=http://localhost/pos_moderno

# Zona horaria IANA. OJO: la preferencia de tienda (stores.preference['timezone'])
# tiene prioridad sobre este valor.
APP_TIMEZONE=America/Caracas

# Idioma por defecto de la aplicacion. Lo usa la pantalla de login (donde
# todavia no hay usuario con preferencia) y como respaldo cuando el idioma
# pedido no existe en la tabla `languages`.
APP_DEFAULT_LANGUAGE=es

# ---------- Base de datos ----------
DB_HOST=localhost
DB_NAME=pos_moderno
DB_USER=root
DB_PASS=
DB_PORT=3306
DB_CHARSET=utf8mb4

# ---------- Opcionales ----------
# Subcarpeta donde se sirve la app. Si se omite, se deduce del path de APP_URL.
# APP_SUBDIRECTORY=pos_moderno

# URL publica de la carpeta de imagenes de productos.
# Si se omite, se deduce como APP_URL/storage/products
# FILEMANAGERURL=http://localhost/pos_moderno/storage/products

# ---------- Flags de la aplicacion (true/false) ----------
# DEMO=true muestra el selector de credenciales de prueba en el login.
DEMO=false
# USECOMPILEDASSET=false sirve el JS desde el codigo fuente.
# USECOMPILEDASSET=true sirve jsmin/main.js (bundle de 4 MB).
USECOMPILEDASSET=true
# USECOMPILEDCSS=false sirve el CSS desde el codigo FUENTE: es lo que hay que
# usar para poder modificar el aspecto, porque el bundle cssmin/main.css no lo
# regenera el build (mix.styles() esta comentado en webpack.mix.js) y arrastra
# una version antigua de theme.css.
# USECOMPILEDCSS=true sirve cssmin/main.css (413 KB).
USECOMPILEDCSS=false
# INSTALLMENT=false desactiva la venta a plazo.
INSTALLMENT=true
# HOOK=true registra las acciones en storage/activity-logs/.
HOOK=false
# LOG=true escribe storage/logs/log.txt.
LOG=false
# SYNCHRONIZATION=true registra las consultas SQL en storage/logs/sql.txt.
SYNCHRONIZATION=false
# RTL=true activa la interfaz de derecha a izquierda.
RTL=false

# URL del servidor remoto para la sincronizacion offline->online.
# SYNCSERVERURL=

# ---------- Sincronizacion offline -> online (sync.php) ----------
# El servidor maestro (sync.php) y cada POS sucursal comparten estas variables.

# Maestro: activar/desactivar el endpoint de sincronizacion.
SYNC_ENABLED=true

# Maestro: clientes autorizados y su secreto, separados por coma.
# Formato: id:secreto,id2:secreto2
# Cada POS sucursal debe tener su propio id y secreto, para que la
# comprometida de una sucursal no permita suplantar a las demas.
# SYNC_CLIENTS=pos-01:cambiar-este-secreto,pos-02:otro-secreto-distinto

# POS sucursal: su propio id y secreto (deben existir en SYNC_CLIENTS del maestro).
# Si no se definen, el POS usa la ruta heredada sin firma.
SYNC_CLIENT_ID=
SYNC_CLIENT_SECRET=

# Transicion: ruta heredada (usuario y contrasena planos, sin firma).
# Deben coincidir con las que usa cada terminal. La credencial original del
# proveedor es publica (via en el codigo que distribute a todos sus clientes):
# rotala en cuanto puedas.
# Poner SYNC_LEGACY_AUTH=false cuando todas las sucursales ya usen la ruta firmada.
SYNC_LEGACY_AUTH=true
SYNC_LEGACY_USERNAME=
SYNC_LEGACY_PASSWORD=

# SOLO en el servidor maestro. Credenciales anteriores que se siguen
# aceptando durante la migracion de los POS que aun no fueron actualizados,
# en formato "usuario:clave" separados por comas.
# Permite rotar la credencial sin dejar fuera a la flota desplegada.
# Vaciar esta variable cuando todos los POS usen ya la ruta firmada.
# SYNC_LEGACY_PREVIOUS=<usuario-actual>:<clave-actual>

# Solo aceptar peticiones firmadas, sin excepcion.
SYNC_REQUIRE_HTTPS=true

# Permitir peticiones desde localhost (solo para pruebas; nunca en produccion).
SYNC_ALLOW_LOCALHOST=false

# Ventana de validez de la marca de tiempo, en segundos.
SYNC_MAX_AGE=300

# Tamano maximo del cuerpo de la peticion, en bytes.
SYNC_MAX_PAYLOAD=2097152

# Maximo de sentencias por peticion.
SYNC_MAX_STATEMENTS=500

# IPs autorizadas a sincronizar. Vacio = cualquier IP.
# SYNC_ALLOWED_IPS=190.1.2.3,190.1.2.4
